# JARPA Plugin - Git Ignore

# JARPA working area (plugin development uses JARPA for itself)
jarpa/

# Local Claude Code config — machine-specific (absolute paths written by hooks)
.claude/

# Python cache (for MCP server)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# MCP server broker file (legacy path, kept for backwards compatibility)
/tmp/claude-context.json
# MCP server broker file (current path pattern)
jarpa-context.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
